# Copy to .env for local development. `npm run infra:up` starts these services.
DATABASE_URL=postgres://app:app@localhost:5432/app
RABBITMQ_URL=amqp://app:app@localhost:5672

# Auth (apps/web). Generate each secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# Signs the short-lived token that opens a realtime socket. Read by apps/web and apps/realtime.
REALTIME_TOKEN_SECRET=replace-with-another-64-hex-characters-from-openssl

# Signs the presentation token of each review question. Read by apps/web only.
REVIEW_TOKEN_SECRET=replace-with-a-third-64-hex-characters-from-openssl
