# Copy to .env for local development. `npm run infra:up` starts these services.
DATABASE_URL=postgres://app:app@localhost:5432/app
# Read by apps/worker, apps/realtime and apps/web (the "Generate questions" route publishes jobs).
# Next.js reads env files only from apps/web, so put RABBITMQ_URL in apps/web/.env.local too.
RABBITMQ_URL=amqp://app:app@localhost:5672

# Auth (apps/web). Generate each secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000

# Signs the short-lived token that opens a realtime socket. Read by apps/web and apps/realtime.
REALTIME_TOKEN_SECRET=replace-with-another-64-hex-characters-from-openssl

# Signs the presentation token of each review question. Read by apps/web only.
REVIEW_TOKEN_SECRET=replace-with-a-third-64-hex-characters-from-openssl
# Dev and E2E only (apps/web/.env.local): lets a review request shift the server's clock with the
# x-review-clock-offset-ms header. Playwright sets it on the dev server it starts; set it yourself
# if Playwright reuses a dev server you started. Ignored when NODE_ENV=production.
# REVIEW_TEST_CLOCK=1

# LLM calls (packages/llm), read by apps/worker, which generates the questions. A Google AI Studio
# key; the free tier works. Required: the worker refuses to start without it.
GOOGLE_GENERATIVE_AI_API_KEY=
# What one user's LLM calls may cost per day, in USD, at paid-tier prices.
LLM_DAILY_BUDGET_USD=0.50
