generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Phase 1 contract (build-plan.md §7.1, task-distribution.md Phase 0).
// Fields are camelCase in TypeScript and snake_case in Postgres via @map.
// Jointly owned: changes to this file need both developers' approval.
//
// Deferred to later phases on purpose:
//   documents.yjs_state, document_access          → Phase 2 (collaboration)
//   chunks.embedding                              → Phase 2 (embedding model not chosen; its size is baked into the column)
//   topics, items.topic_id, chunks.topic_id       → Phase 3
//   exams                                         → Phase 3 (exam mode)
//
// CHECK constraints that Prisma cannot express live in the migration SQL.

// ─── Auth (Better Auth core schema + our two extra fields) ───────────────────

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false) @map("email_verified")
  image           String?
  /// Collected at signup. Under-18 handling follows build-plan.md §11.3.
  dob             DateTime  @db.Date
  parentConsentAt DateTime? @map("parent_consent_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions  Session[]
  accounts  Account[]
  documents Document[]
  sources   Source[]
  reviews   ReviewLog[]
  llmUsage  LlmUsage[]

  cardStates       CardState[]
  reviewSessions   ReviewSession[]
  reviewsPending   ReviewPending[]
  revisionSettings RevisionSettings?

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Workspace (Anurag) ──────────────────────────────────────────────────────

model Document {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id")
  title       String   @default("Untitled")
  /// TipTap JSON. Temporary until Yjs replaces it in Phase 2.
  contentJson Json?    @map("content_json")
  /// Markdown kept in sync by the editor. Ingestion reads only this, never the editor state.
  contentMd   String   @default("") @map("content_md")
  /// Bumped on every save; part of the document.changed hand-off.
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner  User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  source Source?

  @@index([ownerId])
  @@map("documents")
}

// ─── Content pipeline (Anurag) ───────────────────────────────────────────────

enum SourceKind {
  note
  pdf
}

model Source {
  id         String     @id @default(uuid()) @db.Uuid
  ownerId    String     @map("owner_id")
  kind       SourceKind
  /// Set when kind = note.
  documentId String?    @unique @map("document_id") @db.Uuid
  /// Object-storage key. Set when kind = pdf.
  fileKey    String?    @map("file_key")
  title      String
  createdAt  DateTime   @default(now()) @map("created_at")

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   Chunk[]

  @@index([ownerId])
  @@map("sources")
}

model Chunk {
  id          String    @id @default(uuid()) @db.Uuid
  sourceId    String    @map("source_id") @db.Uuid
  /// Stable editor block ids this chunk covers (notes only).
  blockIds    String[]  @map("block_ids")
  /// PDF pages this chunk covers (PDFs only).
  pageStart   Int?      @map("page_start")
  pageEnd     Int?      @map("page_end")
  text        String
  /// Hash of the normalised text. Items are generated once per hash.
  contentHash String    @map("content_hash")
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Set instead of deleting, so old items and reviews keep their citation.
  retiredAt   DateTime? @map("retired_at")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  items  Item[]

  @@index([sourceId, contentHash])
  @@map("chunks")
}

// ─── Shared: items and reviews ───────────────────────────────────────────────

enum ItemType {
  mcq
  cloze
  short_answer
}

/// Items belong to content, not to a user (build-plan.md §7.3).
/// Each user's memory of an item lives in card_state.
model Item {
  id             String    @id @default(uuid()) @db.Uuid
  sourceChunkId  String    @map("source_chunk_id") @db.Uuid
  type           ItemType
  prompt         String
  /// MCQ: the correct option's text. Cloze: the hidden text. Short answer: a model answer.
  answer         String
  /// MCQ only: [{ "id": uuid, "text": string }]. An id is minted once, when the item is created,
  /// and survives edits to its text. Empty array for other types.
  options        Json
  /// MCQ only: the id of the correct option. Answers are graded by option id, never by text.
  answerOptionId String?   @map("answer_option_id") @db.Uuid
  /// Short answer only.
  rubric         String?
  difficultySeed Float?    @map("difficulty_seed")
  createdAt      DateTime  @default(now()) @map("created_at")
  retiredAt      DateTime? @map("retired_at")

  sourceChunk    Chunk           @relation(fields: [sourceChunkId], references: [id], onDelete: Cascade)
  reviews        ReviewLog[]
  cardStates     CardState[]
  reviewsPending ReviewPending[]

  @@index([sourceChunkId])
  @@map("items")
}

enum Confidence {
  sure
  think_so
  no_idea
}

enum ReviewContext {
  solo
  duel
}

/// Append-only. Written only by recordReview() in packages/revision.
/// The migration adds CHECKs: grade 1–4, latency ≥ 0, and a confidence on every solo answer.
model ReviewLog {
  /// No default on purpose: minted when the item is presented (the presentation token's review
  /// id) or by the duel server, so a retried submit hits the same row. The idempotency key.
  id               String        @id @db.Uuid
  itemId           String        @map("item_id") @db.Uuid
  userId           String        @map("user_id")
  reviewedAt       DateTime      @default(now()) @map("reviewed_at")
  /// FSRS grade: 1 Again, 2 Hard, 3 Good, 4 Easy.
  grade            Int           @db.SmallInt
  /// Null for duel answers (build-plan.md §11.2).
  confidence       Confidence?
  correct          Boolean
  /// What the user answered: {"kind":"mcq","option_id":…} or {"kind":"text","text":…}
  /// (reviewResponseSchema in packages/contracts), so a misconception can say "you answered X".
  response         Json?
  latencyMs        Int           @map("latency_ms")
  /// Days since this user's previous review of the item. Null on the first review.
  elapsedDays      Float?        @map("elapsed_days")
  context          ReviewContext @default(solo)
  schedulerVersion String        @map("scheduler_version")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([itemId, userId])
  @@map("review_log")
}

// ─── Revision engine (Vaibhav) ───────────────────────────────────────────────

/// One user's memory of one item: a cache of fold(scheduler.next, review_log) that can be rebuilt
/// at any time. Written only by recordReview() and rebuildCardState() in packages/revision.
model CardState {
  userId             String    @map("user_id")
  itemId             String    @map("item_id") @db.Uuid
  /// The scheduler that wrote `state`, e.g. "placeholder-v0". Only that scheduler advances it.
  schedulerVersion   String    @map("scheduler_version")
  /// The scheduler's CardState (packages/scheduler), discriminated by state.kind.
  state              Json
  /// Mirror of state.due_at: the one field the queue filters on.
  dueAt              DateTime  @map("due_at")
  /// Set by a confident wrong answer: retest from the start of the next local day.
  misconceptionUntil DateTime? @map("misconception_until")
  /// Set from the injected clock, like every time the engine writes.
  updatedAt          DateTime  @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([userId, itemId])
  @@index([userId, dueAt])
  @@index([userId, misconceptionUntil])
  @@map("card_state")
}

/// A user's persisted plan for one local day, so progress and order stay stable across tabs.
model ReviewSession {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id")
  /// The user's local day (revision_settings.timezone) this plan belongs to.
  localDate     DateTime @map("local_date") @db.Date
  budgetSec     Int      @map("budget_sec")
  /// Ordered entries, each with the features that ranked it.
  plan          Json
  /// Ranker version, config hash and the numbers the plan was built from.
  meta          Json
  extendedCount Int      @default(0) @map("extended_count")
  createdAt     DateTime @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pending ReviewPending[]

  @@unique([userId, localDate])
  @@map("review_sessions")
}

enum ReviewPendingStatus {
  queued
  failed
}

/// A short answer waiting for LLM grading in the worker. Deleted in the transaction that writes its
/// review_log row; the queue skips items that have one, so they are not served twice.
model ReviewPending {
  /// Becomes review_log.id once graded.
  reviewId    String              @id @map("review_id") @db.Uuid
  userId      String              @map("user_id")
  itemId      String              @map("item_id") @db.Uuid
  sessionId   String?             @map("session_id") @db.Uuid
  confidence  Confidence
  /// Same shape as review_log.response.
  response    Json
  latencyMs   Int                 @map("latency_ms")
  submittedAt DateTime            @map("submitted_at")
  status      ReviewPendingStatus
  attempts    Int                 @default(0)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  item    Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  session ReviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, itemId])
  @@map("review_pending")
}

/// Per-user revision settings, kept out of `users` so the auth table stays Better Auth's.
/// The migration adds a CHECK keeping the budget between 300 and 3600 seconds.
model RevisionSettings {
  userId         String   @id @map("user_id")
  /// Daily review budget in seconds.
  dailyBudgetSec Int      @default(900) @map("daily_budget_sec")
  /// IANA time zone that defines "today" and "the next day" for this user.
  timezone       String   @default("Asia/Kolkata")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("revision_settings")
}

// ─── LLM cost tracking ───────────────────────────────────────────────────────

/// One row per LLM call, written by packages/llm. Also drives the daily budget check.
model LlmUsage {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  /// e.g. "item_generation", "ghost_text", "chat", "grading"
  feature      String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  costUsd      Decimal  @map("cost_usd") @db.Decimal(12, 6)
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("llm_usage")
}
