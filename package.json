{
  "name": "study-workspace",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.11.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace @repo/db",
    "postinstall": "npm run generate --workspaces --if-present",
    "db:generate": "npm run generate --workspace @repo/db",
    "db:migrate:dev": "npm run migrate:dev --workspace @repo/db --",
    "db:studio": "npm run studio --workspace @repo/db"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
