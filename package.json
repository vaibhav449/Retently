{
  "name": "study-workspace",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @repo/db migrate"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.9"
  }
}
