# Copy to $APP_DIR/.env on the VM (for example /opt/study-workspace/.env). Never commit the real file.
# Generate passwords with:  openssl rand -hex 24   (hex keeps them safe inside connection URLs)

# Where the images live: ghcr.io/<github-owner>/<repo>, all lowercase
IMAGE_PREFIX=ghcr.io/your-github-user/your-repo

# A domain pointing at this VM (gets HTTPS automatically), or :80 for plain HTTP on the IP
SITE_ADDRESS=:80

POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me
